# Required: Convex deployment URL (set automatically by `npx convex dev`)
VITE_CONVEX_URL=your-deployment-url

# Required on the Convex deployment for Convex Auth (ES256 keypair)
# Generate with the @convex-dev/auth CLI or set manually - see README
JWT_PRIVATE_KEY=<pkcs8 PEM private key>
JWKS={"keys":[<public JWK with alg ES256>]}

# App settings on the Convex deployment
SITE_URL=http://localhost:5173
SEED_ADMIN_SECRET=<random-string, gates admin/demo-data seeding>

# Email OTP: Resend API key. Free tier can only send to your own email
RESEND_API_KEY=<from resend.com>

# Optional dev fallback: log OTP codes to the server console instead of email
# (only used when RESEND_API_KEY is not set)
DEV_CONSOLE_OTP=true
